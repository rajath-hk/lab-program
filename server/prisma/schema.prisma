datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  COMPILATION_ERROR
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(STUDENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submissions   Submission[]
  problems      Problem[]       // Problems created by this user (if Teacher)
  tabViolations TabViolation[]
}

model Problem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String   // Markdown content
  boilerplateCode String   // Default structure provided to students
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacherId String @db.ObjectId
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  testCases   TestCase[]
  hintRules   HintRule[]
  submissions Submission[]
}

model TestCase {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  problemId      String  @db.ObjectId
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean @default(true)
}

model HintRule {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  problemId    String  @db.ObjectId
  problem      Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  regexPattern String
  hintMessage  String
}

model Submission {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  userId        String           @db.ObjectId
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String           @db.ObjectId
  problem       Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sourceCode    String
  languageId    Int              // Judge0 language code (e.g., 62 for Java, 71 for Python)
  status        SubmissionStatus @default(PENDING)
  errorMessage  String?          // Raw stderr or error trace from sandbox
  executionTime Float?           // CPU execution time in seconds from Judge0
  createdAt     DateTime         @default(now())

  @@index([userId, problemId])
}

model TabViolation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  details   String   // Details about the tab switch infraction
}
