generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXTREME
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(STUDENT)
  isOnboarded Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student       Student?
  teacher       Teacher?
  activityLogs  ActivityLog[]
  notifications Notification[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "NEW_ASSIGNMENT" | "GRADE_PUBLISHED" | "ANNOTATION_ADDED"
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Department {
  id       String    @id @default(cuid())
  name     String
  code     String    @unique
  students Student[]
}

model Student {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  rollNumber   String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Int
  submissions  Submission[]
  createdAt    DateTime   @default(now())

  @@index([departmentId])
  @@index([semester])
}

model Teacher {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  employeeId String    @unique
  programs   Program[]
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Program {
  id           String               @id @default(cuid())
  title        String
  description  String
  unlockDate   DateTime
  deadline     DateTime?
  teacherId    String
  teacher      Teacher              @relation(fields: [teacherId], references: [id])
  questions    Question[]
  bulkUploads  QuestionBulkUpload[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([teacherId])
  @@index([unlockDate])
}

model Question {
  id          String       @id @default(cuid())
  programId   String
  program     Program      @relation(fields: [programId], references: [id])
  title       String
  description String
  difficulty  Difficulty   @default(EASY)
  orderNumber Int
  starterCode String?
  testCases   String?      // JSON array: [{ input, expectedOutput }]
  submissions Submission[]
  createdAt   DateTime     @default(now())

  @@index([programId])
  @@unique([programId, orderNumber])
}

model QuestionBulkUpload {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  fileName    String
  questionCount Int
  questions   String   // JSON array of uploaded question data
  createdAt   DateTime @default(now())
}

model Submission {
  id          String           @id @default(cuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  code        String
  language    String
  output      String?
  status      SubmissionStatus @default(PENDING)
  feedback    String?
  annotations String?          // JSON array: [{ lineNumber, text, createdAt }]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt


  @@index([studentId])
  @@index([questionId])
  @@index([status])
  @@unique([studentId, questionId])
}
