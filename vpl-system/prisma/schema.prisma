generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXTREME
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  teacher   Teacher?
  activityLogs ActivityLog[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Department {
  id       String    @id @default(cuid())
  name     String
  code     String    @unique
  students Student[]
}

model Student {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  rollNumber   String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Int
  submissions  Submission[]
  createdAt    DateTime   @default(now())
}

model Teacher {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  employeeId String    @unique
  programs   Program[]
  createdAt  DateTime  @default(now())
}

model Program {
  id           String               @id @default(cuid())
  title        String
  description  String
  unlockDate   DateTime
  deadline     DateTime?
  teacherId    String
  teacher      Teacher              @relation(fields: [teacherId], references: [id])
  questions    Question[]
  bulkUploads  QuestionBulkUpload[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Question {
  id          String       @id @default(cuid())
  programId   String
  program     Program      @relation(fields: [programId], references: [id])
  title       String
  description String
  difficulty  Difficulty   @default(EASY)
  orderNumber Int
  starterCode String?
  submissions Submission[]
  createdAt   DateTime     @default(now())
}

model QuestionBulkUpload {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  fileName    String
  questionCount Int
  questions   String   // JSON array of uploaded question data
  createdAt   DateTime @default(now())
}

model Submission {
  id         String           @id @default(cuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  questionId String
  question   Question         @relation(fields: [questionId], references: [id])
  code       String
  language   String
  output     String?
  status     SubmissionStatus @default(PENDING)
  feedback   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}
